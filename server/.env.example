# Gemini API Key (Required for architectural spatial anchor detection)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 8000)
PORT=8000

# Hugging Face Access Token (Optional)
HF_TOKEN=your_huggingface_token_optional

# Google Colab ControlNet GPU Bridge (Optional - via ngrok tunnel)
# If omitted or unavailable, the engine automatically fails over to Pollinations.ai & cached assets
COLAB_BRIDGE_URL=https://your-ngrok-tunnel-url.ngrok-free.dev
